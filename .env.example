# PostgreSQL connection string (required).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neon_syndicate?schema=public"

# 32+ char random string used to sign session JWTs (required).
# Generate one with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-32-or-more-character-random-string"

# Public app URL — used by /api/auth/logout to build the redirect target.
APP_URL="http://localhost:3000"
